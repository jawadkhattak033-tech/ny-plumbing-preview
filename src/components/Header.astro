---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { business, facts, tel, mapsLink, fullAddress, url, getServices, getCommercial, getRegions, getTowns, FEATURED_TOWNS } from '../lib/site';

const [services, commercial, regions, towns] = await Promise.all([getServices(), getCommercial(), getRegions(), getTowns()]);
const featured = FEATURED_TOWNS.map((s) => towns.find((t) => t.slug === s)).filter(Boolean) as typeof towns;
const path = Astro.url.pathname;
const on = (prefix: string) => (path.startsWith(prefix) ? 'active' : undefined);
const areaActive = path.startsWith('/service-areas/') || path.startsWith('/regions/') || towns.some((t) => path === url.town(t.slug));
const aboutPaths = ['/about/', '/our-work/', '/reviews/', '/guides/', '/careers/'];
const aboutLinks = [
  { href: '/about/', label: `About ${business.shortName}` },
  { href: '/our-work/', label: 'Our Work' },
  { href: '/reviews/', label: 'Reviews' },
  { href: '/guides/', label: 'Guides and Cost Guides' },
  { href: '/careers/', label: 'Careers' },
];
---
<div class="top-bar"><div class="container"><div class="top-bar-inner">
  <a href={mapsLink} target="_blank" rel="noopener noreferrer" class="hide-sm"><Icon name="pin" size={15} /> {fullAddress}</a>
  <span class="local-strip" hidden><Icon name="pin" size={15} /> <span class="local-name"></span></span>
  <span class="hide-sm"><Icon name="clock" size={15} /> {business.hours.summary}</span>
  <span><Icon name="star" size={15} /> <strong>{facts.rating} Rating</strong>&nbsp;&middot; {facts.reviews} Google Reviews</span>
</div></div></div>

<header class="header"><div class="container">
  <Logo class="header-logo" />
  <nav class="header-nav" aria-label="Main navigation">
    <div class="nav-links">
      <div class="nav-dropdown">
        <a href="/plumbing/" class={on('/plumbing/')}>Plumbing <Icon name="chevron" size={14} /></a>
        <div class="dropdown-menu wide">
          {services.map((s) => <a href={url.service(s.slug)} class={path === url.service(s.slug) ? 'active' : undefined}>{s.title}</a>)}
        </div>
      </div>
      <div class="nav-dropdown">
        <a href="/commercial/" class={on('/commercial/')}>Commercial <Icon name="chevron" size={14} /></a>
        <div class="dropdown-menu">
          {commercial.map((s) => <a href={url.commercial(s.slug)} class={path === url.commercial(s.slug) ? 'active' : undefined}>{s.title}</a>)}
        </div>
      </div>
      <div class="nav-dropdown">
        <a href="/service-areas/" class={areaActive ? 'active' : undefined}>Service Areas <Icon name="chevron" size={14} /></a>
        <div class="dropdown-menu wide">
          <span class="dropdown-label">Regions</span>
          {regions.map((r) => <a href={url.region(r.slug)}>{r.name}</a>)}
          <span class="dropdown-label">Capital Region</span>
          {featured.map((t) => <a href={url.town(t.slug)}>{t.name}</a>)}
          <a href="/service-areas/">All {business.address.stateName} areas</a>
        </div>
      </div>
      <div class="nav-dropdown">
        <a href="/about/" class={aboutPaths.some((p) => path.startsWith(p)) ? 'active' : undefined}>About <Icon name="chevron" size={14} /></a>
        <div class="dropdown-menu">
          {aboutLinks.map((l) => <a href={l.href} class={path === l.href ? 'active' : undefined}>{l.label}</a>)}
        </div>
      </div>
      <a href="/contact/" class={on('/contact/')}>Contact</a>
    </div>
    <div class="header-cta">
      <a href={tel} class="header-phone"><Icon name="phone" size={20} /><span><small>24/7 Service</small>{business.phone}</span></a>
      <a href="#request" data-popup="book" class="btn btn-red btn-sm">Request Service</a>
    </div>
  </nav>
  <button class="hamburger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-drawer"><span></span><span></span><span></span></button>
</div></header>

<div class="drawer-overlay"></div>
<nav class="mobile-drawer" id="mobile-drawer" aria-label="Mobile navigation">
  <div class="drawer-header"><Logo href={null} /><button class="drawer-close" type="button" aria-label="Close menu"><Icon name="close" size={22} /></button></div>
  <div class="drawer-cta">
    <a href={tel} class="btn btn-blue"><Icon name="phone" size={18} /> {business.phone}</a>
    <a href="#request" data-popup="book" class="btn btn-red">Request Service</a>
  </div>
  <div class="drawer-nav">
    <a href="/">Home</a>
    <button class="drawer-toggle" type="button" aria-expanded="false">Plumbing Services <Icon name="chevron" size={18} class="chevron" /></button>
    <div class="drawer-list"><a href="/plumbing/">All plumbing services</a>{services.map((s) => <a href={url.service(s.slug)}>{s.title}</a>)}</div>
    <button class="drawer-toggle" type="button" aria-expanded="false">Commercial <Icon name="chevron" size={18} class="chevron" /></button>
    <div class="drawer-list"><a href="/commercial/">All commercial services</a>{commercial.map((s) => <a href={url.commercial(s.slug)}>{s.title}</a>)}</div>
    <button class="drawer-toggle" type="button" aria-expanded="false">Service Areas <Icon name="chevron" size={18} class="chevron" /></button>
    <div class="drawer-list"><a href="/service-areas/">All {business.address.stateName} areas</a>{regions.map((r) => <a href={url.region(r.slug)}>{r.name}</a>)}{featured.map((t) => <a href={url.town(t.slug)}>{t.name}</a>)}</div>
    <a href="/our-work/">Our Work</a>
    <a href="/guides/">Guides and Cost Guides</a>
    <a href="/reviews/">Reviews</a>
    <a href="/about/">About</a>
    <a href="/careers/">Careers</a>
    <a href="/contact/">Contact</a>
  </div>
  <div class="drawer-info"><p>{fullAddress}</p><p>{business.hours.summary}</p></div>
</nav>
